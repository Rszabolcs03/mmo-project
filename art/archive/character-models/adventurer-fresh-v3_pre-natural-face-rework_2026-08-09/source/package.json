{
  "name": "mmo-project",
  "private": true,
  "version": "0.4.95",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.js",
    "start": "node server/index.js",
    "start:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "electron": "npm run build && electron .",
    "electron:pack": "npm run build && set ELECTRON_BUILDER_CACHE=.cache\\electron-builder&& electron-builder --dir",
    "electron:dist": "npm run build && set ELECTRON_BUILDER_CACHE=.cache\\electron-builder&& electron-builder",
    "generate:characters": "node scripts/generate-human-fresh-assets.mjs",
    "generate:human": "npm run generate:characters",
    "verify:characters": "node scripts/validate-human-fresh-assets.mjs && node scripts/validate-human-fresh-runtime.mjs && node scripts/render-human-fresh-contact-sheets.mjs && node scripts/render-adventurer-fresh-race-contact-sheet.mjs",
    "verify:human": "npm run verify:characters",
    "verify:character-creation": "npm run verify:characters && npm run build",
    "verify:packaged-client": "node scripts/verify-packaged-client.mjs",
    "verify:update-payload": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\verify-update-payload.ps1",
    "update:prepare": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\prepare-update.ps1",
    "generate:sprites": "node scripts/generate-character-sprites.mjs && node scripts/generate-game-assets.mjs && node scripts/generate-ability-assets.mjs",
    "generate:game-assets": "node scripts/generate-game-assets.mjs",
    "generate:ability-assets": "node scripts/generate-ability-assets.mjs",
    "generate:human-zone": "node scripts/generate-human-starting-zone.mjs",
    "generate:human-zone:v2": "node scripts/improveHumanStartingZone.js",
    "generate:human-buildings:v1": "node scripts/generateHumanBuildingsV1.js",
    "generate:human-zone:v4": "node scripts/improveHumanStartingZoneV4.js",
    "generate:race-zones": "node scripts/generate-race-starting-zones.mjs",
    "generate:world": "node scripts/generate-world-map.mjs",
    "generate:world:v2-chunks": "node scripts/generate-world-v2-chunks.mjs",
    "generate:world:v3": "node scripts/generate-world-map-v3.mjs",
    "generate:world:v3-overview": "node scripts/generate-world-v3-overview.mjs",
    "generate:world:v3-chunks": "node scripts/generate-world-v3-chunks.mjs",
    "generate:world:v4-overview": "node scripts/generate-world-v3-overview.mjs",
    "generate:world:v4-chunks": "node scripts/generate-world-v3-chunks.mjs",
    "convert:tamzia-spawn-shapes": "node scripts/convert-tamzia-spawns-to-polygons.mjs --apply",
    "apply:tamzia-river-tribe": "node scripts/generate-tamzia-river-bridge-v2.mjs && node scripts/apply-tamzia-river-tribe-camp.mjs && node scripts/apply-tamzia-river-region-seam.mjs && node scripts/smooth-tamzia-northeast-region-seam.mjs && node scripts/apply-continent-01-river-flow.mjs",
    "generate:tamzia-river-bridge": "node scripts/generate-tamzia-river-bridge-v2.mjs",
    "generate:brightwater-ford-bridge": "node scripts/generate-brightwater-ford-bridge.mjs",
    "apply:continent-01-river-flow": "node scripts/apply-continent-01-river-flow.mjs",
    "generate:tamzia-fountain": "node scripts/generate-tamzia-fountain-sprite.mjs",
    "generate:world-box-teszt": "node scripts/generate-world-box-teszt.mjs",
    "generate:world:v4-buildings": "node scripts/generate-world-v4-buildings.mjs",
    "generate:dungeon:01": "node scripts/generate-dungeon-01.mjs",
    "generate:dungeon-enemies": "node scripts/generate-dungeon-enemy-sprites.mjs",
    "resize:dungeon:01": "node scripts/expand-dungeon-01.mjs"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@colyseus/schema": "^4.0.25",
    "@colyseus/sdk": "^0.17.42",
    "@vitejs/plugin-react": "latest",
    "colyseus": "^0.17.10",
    "firebase": "^12.13.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.mmo.project",
    "productName": "Top-Down MMO Prototype",
    "npmRebuild": false,
    "electronDownload": {
      "cache": ".cache/electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "artifactName": "${productName} Setup.${ext}",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
